# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.local

# --- Python / backend ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- App data / caches (local only, never commit) ---
# SQLite progress store
*.sqlite
*.sqlite3
*.db
# Cached nlm artifact downloads (quizzes, reports, etc.) + review-session scratch.
# The runtime data dir defaults to backend/data (see app/config.py), so ignore it wherever
# it lands — these patterns are unanchored on purpose.
.cache/
**/data/cache/
backend/data/

