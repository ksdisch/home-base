# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Superpowers brainstorm scratch (visual companion mockups) ---
.superpowers/

# --- Secrets / env ---
.env
.env.*
!.env.example
# Delivery recipients (email + iMessage handle) are PII in a public repo — the real
# config stays local; sweeps/delivery.example.json is the tracked template.
sweeps/delivery.json

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.local

# --- Python / backend ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- App data / caches (local only, never commit) ---
# SQLite progress store
*.sqlite
*.sqlite3
*.db
# Cached nlm artifact downloads (quizzes, reports, etc.) + review-session scratch.
# The runtime data dir defaults to backend/data (see app/config.py), so ignore it wherever
# it lands — these patterns are unanchored on purpose.
.cache/
**/data/cache/
backend/data/

# M0 sweep outputs — regenerable daily briefs; grade them, don't commit.
/data/sweeps/
# nlm CLI default download names (./{notebook_id}_<type>.<ext>) — pre-fix server runs dropped
# these into backend/, and a quiz one carries the full ANSWER KEY; never let one get added.
backend/*_quiz.json
backend/*_report.md
backend/*_flashcards.*

# Keep the curated reference fixtures (docs/fixtures/*) tracked.

# Playwright MCP browser session artifacts (snapshots/console logs)
.playwright-mcp/
