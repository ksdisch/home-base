%% The forgetting curve: retention decays after learning, but each review flattens the next drop.
xychart-beta
    title "Retention over time: no review vs. spaced review"
    x-axis "Days since learning" [0, 1, 2, 4, 7, 14]
    y-axis "Recall (%)" 0 --> 100
    line "No review" [100, 58, 44, 32, 21, 12]
    line "Spaced review" [100, 86, 90, 78, 88, 84]
